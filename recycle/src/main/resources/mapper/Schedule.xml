<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.recycle.dao.ScheduleDao">

    <select id="getScheduleList"
            resultType="com.example.recycle.dto.ScheduleDto">

        SELECT
            scheduleId,
            scheduleName,
            scheduleDate,
            executionTime,
            status,
            task,
            description
        FROM SCHEDULE

    </select>

</mapper>